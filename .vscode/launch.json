{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32WL M4",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "bmp",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/MM_MB_1_v1_X-FW.elf",
            "gdbPath": "gdb-multiarch",
            "objdumpPath": "arm-none-eabi-objdump",
            "BMPGDBSerialPort": "/dev/ttyACM0",
            "interface": "swd",
            "targetId": 1,
            "showDevDebugOutput": "none",
            "svdFile": "${workspaceFolder}/STM32WL5x_CM4.svd",
            "preLaunchCommands": [
                "monitor connect_rst enable",
                "monitor tpwr enable"
            ],
            "postLaunchCommands": [
                "monitor erase_mass",
                "load",
                "break main",
                // Real system reset (not just moving the PC), so RCC, I2C1, GPIO
                // etc. start clean. DEMCR.VC_CORERESET makes the core halt at
                // Reset_Handler; it is cleared right after so a later IWDG reset
                // during the session runs normally instead of halting.
                "set *(unsigned int *)0xE000EDFC = 0x01000001",
                "set *(unsigned int *)0xE000ED0C = 0x05FA0004",
                "set *(unsigned int *)0xE000EDFC = 0x01000000",
                "flushregs",
                // "continue"
            ]
        }
    ]
}
